DATABASE_URL=postgresql://portway:portway@127.0.0.1:5432/portway?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=8080
# Default durable backend. Memory mode is explicit and intended for isolated tests.
API_STORAGE=postgres
# Optional numeric DNS resolver for ownership proofs; system DNS is the default.
# API_DNS_SERVER=127.0.0.1:5353
DASHBOARD_PORT=3000
# make dev supplies these defaults with the configured API/dashboard ports.
# Standalone production needs fixed HTTPS URLs and a private session-key file.
# DASHBOARD_API_URL=http://127.0.0.1:8080/api/v1
# DASHBOARD_ORIGIN=http://127.0.0.1:3000
# DASHBOARD_SESSION_KEY_FILE=/absolute/path/to/private/dashboard-session-key
# Complete upstream deadline in milliseconds, allowed 100..10000.
# DASHBOARD_API_TIMEOUT_MS=5000
RELAY_PORT=8081
RELAY_BIND_HOST=127.0.0.1
RELAY_TLS_CERT_FILE=.tmp/dev/relay-cert.pem
RELAY_TLS_KEY_FILE=.tmp/dev/relay-key.pem
RELAY_CREDENTIALS_FILE=.tmp/dev/relay-credentials.json
RELAY_MAX_CONNECTIONS=128
RELAY_MAX_FRAME_BYTES=4194304
RELAY_HANDSHAKE_TIMEOUT=10s
RELAY_REGISTRATION_TIMEOUT=10s
RELAY_MAX_TUNNELS=1024
RELAY_IDLE_TIMEOUT=120s
RELAY_WRITE_TIMEOUT=5s
RELAY_SHUTDOWN_TIMEOUT=10s
POSTGRES_PORT=5432
REDIS_PORT=6379
PUBLIC_BASE_DOMAIN=portway.localhost
PUBLIC_PORT=8443
PUBLIC_BIND_HOST=127.0.0.1
PUBLIC_TLS_CERT_FILE=.tmp/dev/public-cert.pem
PUBLIC_TLS_KEY_FILE=.tmp/dev/public-key.pem
# Private JSON manifest for custom domains and optional renewed default pair.
# Requires authenticated relay reporting; relative PEM paths use its directory.
# PUBLIC_TLS_MANIFEST_FILE=.tmp/certificates/certificate.json
PUBLIC_TLS_RELOAD_INTERVAL=30s
# Optional override used by development readiness; defaults to .tmp/dev/public-ca.pem.
# PUBLIC_TLS_CA_FILE=.tmp/dev/public-ca.pem
PUBLIC_MAX_CONNECTIONS=128
RELAY_MAX_STREAMS=32
# Application idle timeout with negotiated streaming; whole-request for legacy peers.
RELAY_STREAM_TIMEOUT=30s
PORTWAY_MAX_STREAMS=32
PORTWAY_STREAM_TIMEOUT=30s
PORTWAY_JSON=0
PORTWAY_API_URL=http://localhost:8080/api/v1
PORTWAY_RELAY_CA_FILE=.tmp/dev/ca.pem
PORTWAY_TOKEN_FILE=.tmp/dev/agent-token
PORTWAY_CONNECT_TIMEOUT=10s
PORTWAY_HANDSHAKE_TIMEOUT=10s
PORTWAY_REGISTRATION_TIMEOUT=10s
PORTWAY_TUNNEL_ID=tnl_local_dev
PORTWAY_STATE_DIR=.tmp/agent-state
# Optional recovery override; must exceed the relay's highest accepted generation.
# PORTWAY_GENERATION=1
PORTWAY_IDLE_TIMEOUT=120s
PORTWAY_WRITE_TIMEOUT=5s
PORTWAY_SHUTDOWN_TIMEOUT=10s
# Optional overrides; defaults use 127.0.0.1 and RELAY_PORT.
# PORTWAY_RELAY_ADDR=127.0.0.1:8081
# PORTWAY_RELAY_SERVER_NAME=localhost

# Hash-only provisioning for db:seed (memory mode loads it directly); make setup creates private development files.
# API_SEED_FILE=.tmp/dev/control-seed.json
API_CREDENTIAL_TTL_SECONDS=300
# Enable API bootstrap for portway <port> (diagnostics use the direct token).
# PORTWAY_API_TOKEN_FILE=.tmp/dev/api-token
# PORTWAY_API_CA_FILE=/path/to/api-ca.pem
# PORTWAY_API_TIMEOUT=5s
# Relay API verification replaces file credentials; all three settings are required.
# RELAY_API_URL=http://localhost:8080/api/v1
# RELAY_API_TOKEN_FILE=.tmp/dev/relay-api-token
# RELAY_ID=rel_local
# RELAY_API_CA_FILE=/path/to/api-ca.pem
# RELAY_API_TIMEOUT=5s

# Live fleet reporting inherits RELAY_API_* and RELAY_ID in control mode.
RELAY_API_REPORT_INTERVAL=2s
# Independent reporting for a private-file relay (make dev sets these itself):
# RELAY_REPORT_API_URL=http://localhost:8080/api/v1
# RELAY_REPORT_API_TOKEN_FILE=.tmp/dev/relay-api-token
# RELAY_REPORT_API_CA_FILE=/path/to/api-ca.pem
# RELAY_REPORT_ID=rel_local

# Optional operator scrapes; 0 disables. Always bind to 127.0.0.1.
RELAY_METRICS_PORT=0
PORTWAY_METRICS_PORT=0
