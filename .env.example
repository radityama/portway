DATABASE_URL=postgresql://portway:portway@127.0.0.1:5432/portway?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=8080
DASHBOARD_PORT=3000
RELAY_PORT=8081
RELAY_BIND_HOST=127.0.0.1
RELAY_TLS_CERT_FILE=.tmp/dev/relay-cert.pem
RELAY_TLS_KEY_FILE=.tmp/dev/relay-key.pem
RELAY_CREDENTIALS_FILE=.tmp/dev/relay-credentials.json
RELAY_MAX_CONNECTIONS=128
RELAY_MAX_FRAME_BYTES=4194304
RELAY_HANDSHAKE_TIMEOUT=10s
RELAY_IDLE_TIMEOUT=120s
RELAY_WRITE_TIMEOUT=5s
POSTGRES_PORT=5432
REDIS_PORT=6379
PUBLIC_BASE_DOMAIN=portway.localhost
PORTWAY_JSON=0
PORTWAY_API_URL=http://localhost:8080/api/v1
PORTWAY_RELAY_CA_FILE=.tmp/dev/ca.pem
PORTWAY_TOKEN_FILE=.tmp/dev/agent-token
PORTWAY_CONNECT_TIMEOUT=10s
PORTWAY_HANDSHAKE_TIMEOUT=10s
PORTWAY_IDLE_TIMEOUT=120s
PORTWAY_WRITE_TIMEOUT=5s
# Optional overrides; defaults use 127.0.0.1 and RELAY_PORT.
# PORTWAY_RELAY_ADDR=127.0.0.1:8081
# PORTWAY_RELAY_SERVER_NAME=localhost
