{
  "name": "portway",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "10.12.1"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "doctor": "node scripts/doctor.mjs",
    "build": "pnpm --recursive build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --recursive typecheck",
    "test": "node --test scripts/tests/*.test.mjs && pnpm --recursive --if-present test",
    "db:generate": "pnpm --filter @portway/api prisma:generate",
    "db:migrate": "pnpm --filter @portway/api prisma:migrate",
    "db:validate": "pnpm --filter @portway/api prisma:validate",
    "test:bootstrap": "node --test scripts/tests/dev.integration.mjs",
    "test:control": "node --test scripts/tests/control.integration.mjs",
    "db:deploy": "pnpm --filter @portway/api prisma:deploy",
    "db:seed": "pnpm --filter @portway/api prisma:seed",
    "test:database": "node --test scripts/tests/database.integration.mjs",
    "test:database-control": "node --test scripts/tests/database-control.integration.mjs"
  },
  "devDependencies": {
    "@prisma/client": "6.19.3",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "15.5.26",
    "@types/node": "24.3.0",
    "eslint": "10.11.0",
    "globals": "17.3.0",
    "prettier": "3.9.9",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.0"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.23",
      "next>sharp": "0.35.4",
      "@prisma/config>deepmerge-ts": "8.0.0"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
